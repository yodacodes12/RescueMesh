# Backend configuration. Copy to backend/.env. Never commit real values.
DATABASE_URL=postgresql+psycopg://rescuemesh:CHANGE_ME@localhost:5433/rescuemesh
TEST_DATABASE_URL=postgresql+psycopg://rescuemesh:CHANGE_ME@localhost:5433/rescuemesh_test
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
# Comma-separated list of dashboard origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
# First coordinator account created by `python -m app.init_db`.
# Leave ADMIN_PASSWORD empty to have a random one generated and printed once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
